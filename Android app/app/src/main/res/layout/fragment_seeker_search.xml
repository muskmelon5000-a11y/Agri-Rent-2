<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />

        <!-- Map Button Action -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnHeaderMap"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#E8F5E9">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bottom_map"
                android:tint="#2E7D32"
                android:layout_gravity="center" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:elevation="1dp">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_outline"
            android:hint="Search tractors, tools..."
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingHorizontal="14dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchSubmit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Search"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#2E7D32"
            app:cornerRadius="10dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Sort & Filters Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <!-- Filters Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltersToggle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="⚡ Filters"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold"
            app:strokeColor="#2E7D32"
            app:strokeWidth="1.5dp"
            app:cornerRadius="10dp"
            android:layout_marginEnd="6dp" />

        <!-- Sort Spinner Dropdown -->
        <Spinner
            android:id="@+id/spinnerSort"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_outline"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Collapsible Filters Box -->
    <LinearLayout
        android:id="@+id/layoutFiltersBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0FDF4"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter by Machinery Category"
            android:textColor="#166534"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerSearchCategory"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_outline"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etFilterMinPrice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:background="@drawable/bg_input_outline"
                android:hint="Min ₹"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etFilterMaxPrice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:background="@drawable/bg_input_outline"
                android:hint="Max ₹"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplySearchFilters"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Apply"
                android:textSize="12sp"
                android:backgroundTint="#2E7D32"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Results Count Label -->
    <TextView
        android:id="@+id/tvResultsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Machinery"
        android:textColor="#4B5563"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp" />

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No machinery matches your search criteria."
        android:textColor="#9CA3AF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- Results Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
